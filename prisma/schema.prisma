// LLM Trading Battle Arena Schema - Production
// PostgreSQL migration from SQLite prototype

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH MODELS (NextAuth.js)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?

  accounts      Account[]
  sessions      Session[]
  positions     Position[]
  orders        Order[]
  balance       AccountBalance?
  tradeCards    TradeCard[]
  battles       ModelBattle[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// ACCOUNT & TRADING MODELS
// ============================================================================

model AccountBalance {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cashBalance   Decimal  @default(10000) @db.Decimal(15, 2)  // Starting paper capital
  equityValue   Decimal  @default(10000) @db.Decimal(15, 2)
  buyingPower   Decimal  @default(10000) @db.Decimal(15, 2)
  totalPnl      Decimal  @default(0) @db.Decimal(15, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("account_balances")
}

model Position {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol        String
  side          String   // LONG | SHORT
  quantity      Decimal  @db.Decimal(15, 8)
  avgEntryPrice Decimal  @db.Decimal(15, 8)
  currentPrice  Decimal  @default(0) @db.Decimal(15, 8)
  unrealizedPnl Decimal  @default(0) @db.Decimal(15, 2)
  realizedPnl   Decimal  @default(0) @db.Decimal(15, 2)
  status        String   // OPEN | CLOSED

  openedAt      DateTime @default(now())
  closedAt      DateTime?

  orders        Order[]
  modelId       String?
  model         TradingModel? @relation(fields: [modelId], references: [id])

  @@index([userId, status])
  @@index([symbol])
  @@map("positions")
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionId      String?
  position        Position? @relation(fields: [positionId], references: [id])

  symbol          String
  side            String   // BUY | SELL
  orderType       String   // MARKET | LIMIT | STOP
  quantity        Decimal  @db.Decimal(15, 8)
  limitPrice      Decimal? @db.Decimal(15, 8)
  filledPrice     Decimal? @db.Decimal(15, 8)
  status          String   // PENDING | FILLED | CANCELLED | REJECTED

  brokerOrderId   String?  @unique
  rejectionReason String?

  submittedAt     DateTime @default(now())
  filledAt        DateTime?

  @@index([userId, status])
  @@index([brokerOrderId])
  @@map("orders")
}

model RiskEvent {
  id          String   @id @default(cuid())
  userId      String
  eventType   String   // POSITION_LIMIT | DAILY_LOSS | MARGIN_CALL | CIRCUIT_BREAKER
  severity    String   // WARNING | HALT | LIQUIDATION
  details     Json
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("risk_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // ORDER_SUBMIT | ORDER_FILL | POSITION_OPEN | POSITION_CLOSE | LOGIN | etc.
  entityType  String   // order | position | user | battle
  entityId    String
  details     Json
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// EXISTING MODELS (UPGRADED WITH userId)
// ============================================================================

model TradingModel {
  id            String   @id @default(cuid())
  name          String   @unique
  provider      String
  description   String?
  avatar        String?
  
  // Lifetime stats
  totalTrades   Int      @default(0)
  winCount      Int      @default(0)
  totalPnlPct   Float    @default(0)
  
  tradeCards    TradeCard[]
  battles1      ModelBattle[] @relation("Model1")
  battles2      ModelBattle[] @relation("Model2")
  positions     Position[]     // New: tracks which model suggested trades
  
  createdAt     DateTime @default(now())

  @@map("trading_models")
}

model TradeCard {
  id          String   @id @default(cuid())
  
  // Model info
  modelId     String
  model       TradingModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  // Trade details
  asset       String
  direction   String   // "LONG", "SHORT"
  entryPrice  Float
  exitPrice   Float
  leverage    Float    @default(1)
  
  // Results
  pnlPercent  Float
  pnlUsd      Float
  holdingHours Float
  
  // Card metadata
  rarity      String
  
  // Optional reasoning
  reasoning   String?
  
  // User ownership (optional — null for system-seeded cards)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  @@index([modelId])
  @@index([userId])
  @@index([createdAt])
  @@index([rarity])
  @@map("trade_cards")
}

model ModelBattle {
  id            String   @id @default(cuid())
  
  model1Id      String
  model2Id      String
  
  model1        TradingModel @relation("Model1", fields: [model1Id], references: [id], onDelete: Cascade)
  model2        TradingModel @relation("Model2", fields: [model2Id], references: [id], onDelete: Cascade)
  
  model1Cards   String   // JSON array of TradeCard IDs
  model2Cards   String   // JSON array of TradeCard IDs
  
  model1Score   Float
  model2Score   Float
  
  winnerId      String?
  
  // User ownership (optional — null for system-seeded battles)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())

  @@index([model1Id])
  @@index([model2Id])
  @@index([winnerId])
  @@index([userId])
  @@index([createdAt])
  @@map("model_battles")
}

// ──────────────────────────────────────────────
// Arena v2 — OpenClaw Agent Trading League
// Atlas schema spec 2026-02-19
// ──────────────────────────────────────────────

model ArenaAgent {
  id               String   @id @default(cuid())
  tag              String   @unique    // [DMN], [ATL], [GPT], etc.
  name             String
  modelProvider    String              // anthropic, openai-codex, minimax, etc.
  modelId          String              // claude-opus-4-6, gpt-5.3-codex, etc.
  executionPath    String              // "openclaw" or "direct"
  // sessionKey intentionally omitted — stored in ~/.secrets/arena/ only (TopG blocker 1)
  strategyPrompt   String   @db.Text  // Injected system prompt at trade time
  agentMd          String?  @db.Text  // Full AGENT.md content
  riskMaxExposure  Float    @default(0.50)
  riskMaxLeverage  Float    @default(5.0)
  riskMaxPositions Int      @default(3)
  riskStopLossReq  Boolean  @default(true)
  liveApproved     Boolean  @default(false)  // manual Kyle approval for live trading
  isActive         Boolean  @default(true)
  haltedUntil      DateTime?           // per-agent halt on drawdown breach (TopG note 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seasonEntries    ArenaSeasonEntry[]

  @@map("arena_agents")
}

model ArenaSeason {
  id               String   @id @default(cuid())
  name             String
  roundIntervalMin Int      @default(240)  // 4h default
  tradingPairs     String   @default("BTC,ETH,SOL")  // comma-sep
  tradingMode      String   @default("SIMULATED")  // SIMULATED, PAPER, LIVE
  paperBroker      String?                          // coinbase, alpaca, binance
  isActive         Boolean  @default(true)
  startedAt        DateTime @default(now())
  endedAt          DateTime?

  entries          ArenaSeasonEntry[]
  rounds           ArenaRound[]

  @@map("arena_seasons")
}

model ArenaSeasonEntry {
  id               String   @id @default(cuid())
  agentId          String
  seasonId         String
  startingBalance  Float    @default(10000)
  currentBalance   Float    @default(10000)
  totalPnl         Float    @default(0)
  realizedPnl      Float    @default(0)
  unrealizedPnl    Float    @default(0)
  winCount         Int      @default(0)
  lossCount        Int      @default(0)
  totalTrades      Int      @default(0)
  sharpeRatio      Float    @default(0)
  maxDrawdown      Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent            ArenaAgent          @relation(fields: [agentId], references: [id])
  season           ArenaSeason         @relation(fields: [seasonId], references: [id])
  trades           ArenaTrade[]
  decisions        ArenaRoundDecision[]

  @@unique([agentId, seasonId])
  @@map("arena_season_entries")
}

model ArenaTrade {
  id               String   @id @default(cuid())
  entryId          String
  roundId          String?
  pair             String   // BTC, ETH, SOL
  side             String   // long, short
  entryPrice       Float
  exitPrice        Float?
  size             Float    // Position size in USD
  sizePct          Float    // % of balance at entry
  leverage         Float    @default(1)
  stopLoss         Float?
  takeProfit       Float?
  pnl              Float?
  pnlPct           Float?
  reasoning        String   @db.Text
  confidence       Float?
  riskCheckPassed  Boolean  @default(true)
  killSwitchActive Boolean  @default(false)
  executionMode    String   @default("simulated")  // simulated, paper, live
  externalOrderId  String?                          // exchange order reference
  executedPrice    Float?                           // actual fill price
  slippage         Float?                           // intended vs executed price diff
  status           String   @default("open")  // open, closed, stopped, liquidated, rejected
  openedAt         DateTime @default(now())
  closedAt         DateTime?

  entry            ArenaSeasonEntry @relation(fields: [entryId], references: [id])
  round            ArenaRound?      @relation(fields: [roundId], references: [id])

  @@index([entryId])
  @@index([roundId])
  @@index([status])
  @@index([openedAt])
  @@map("arena_trades")
}

model ArenaRound {
  id               String   @id @default(cuid())
  seasonId         String
  roundNumber      Int
  marketData       Json     // Price snapshot at decision time
  status           String   @default("pending")  // pending, in_progress, completed, failed
  startedAt        DateTime @default(now())
  completedAt      DateTime?

  season           ArenaSeason         @relation(fields: [seasonId], references: [id])
  decisions        ArenaRoundDecision[]
  trades           ArenaTrade[]

  @@unique([seasonId, roundNumber])
  @@index([seasonId])
  @@index([status])
  @@map("arena_rounds")
}

model ArenaRoundDecision {
  id               String   @id @default(cuid())
  roundId          String
  entryId          String
  action           String   // long, short, close, hold
  pair             String?
  sizePct          Float?
  confidence       Float?
  reasoning        String   @db.Text
  rawResponse      String?  @db.Text
  latencyMs        Int?
  tokensUsed       Int?
  riskCheckPassed  Boolean  @default(true)
  rejectionReason  String?
  decidedAt        DateTime @default(now())

  round            ArenaRound       @relation(fields: [roundId], references: [id])
  entry            ArenaSeasonEntry @relation(fields: [entryId], references: [id])

  @@unique([roundId, entryId])
  @@index([roundId])
  @@map("arena_round_decisions")
}
