# Database
# For local development with Docker:
DATABASE_URL="postgresql://arena:arena@localhost:5432/arena"

# For production (Neon PostgreSQL or other):
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth.js (Authentication)
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3030

# OAuth Providers
# Get Google credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Get GitHub credentials at: https://github.com/settings/developers
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# OpenRouter API (required for AI trading decisions)
# Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Broker Integration (Phase 2)
# Get Alpaca credentials at: https://alpaca.markets
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market Data (Phase 2)
# Get Finnhub API key at: https://finnhub.io
# FINNHUB_API_KEY=

# Rate Limiting (optional - for production)
# Without these, rate limiting uses in-memory (resets on serverless cold start)
# Get free tier at: https://upstash.com/
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# App Configuration
PAPER_TRADING_MODE=true
REAL_MONEY_ENABLED=false
ENABLE_LIVE_PRICES=true

# Payment Integration (future - for real money mode)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
